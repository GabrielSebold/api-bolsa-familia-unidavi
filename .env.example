# Copie para .env (cp .env.example .env). NUNCA commite o .env.
PORT=3333
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=false
CORS_ORIGIN=*

# Chave gratuita: http://www.portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TRANSPARENCIA_API_KEY=COLOQUE_SUA_CHAVE_AQUI

# true = força mock; false = força API real; vazio = mock automático (com aviso) se não houver chave
USE_MOCK=

DB_PATH=./data/cache.sqlite

# Se definido, habilita DELETE /api/v1/cache (header x-admin-token)
# ADMIN_TOKEN=troque-por-um-token-longo

RATE_LIMIT_PER_MIN=60
HTTP_TIMEOUT_MS=10000
RETRY_ATTEMPTS=3
RETRY_BASE_MS=1000
CB_FAILURE_THRESHOLD=5
CB_FAILURE_RATE=0.5
CB_WINDOW_MS=60000
CB_OPEN_MS=60000

PRELOAD_ENABLED=false
PRELOAD_CODIGO_IBGE=4214805
IBGE_MUNICIPIOS_URL=https://servicodados.ibge.gov.br/api/v1/localidades/municipios
